{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Chessflow Master Design Tokens",
  "version": "2.0.0",
  "brand": "Chessflow Analytics Inc.",
  "description": "Design Token Specification conforming to W3C Design Tokens format for Chessflow (Dual-Mode: Analytical Light & Nocturnal Grandmaster Dark).",
  "color": {
    "brand": {
      "primary": {
        "light": {
          "$value": "#0f172a",
          "$type": "color",
          "$description": "Primary brand accent, main action triggers (Slate 900)"
        },
        "dark": {
          "$value": "#2563eb",
          "$type": "color",
          "$description": "Primary brand accent in nocturnal mode (Royal Blue 600)"
        }
      },
      "primary-container": {
        "light": {
          "$value": "#1e293b",
          "$type": "color",
          "$description": "Hero action buttons, prominent CTAs (Slate 800)"
        },
        "dark": {
          "$value": "#1d4ed8",
          "$type": "color",
          "$description": "Hero action buttons in nocturnal mode (Deep Blue 700)"
        }
      },
      "on-primary": {
        "light": { "$value": "#ffffff", "$type": "color" },
        "dark": { "$value": "#ffffff", "$type": "color" }
      },
      "secondary": {
        "light": {
          "$value": "#0284c7",
          "$type": "color",
          "$description": "Stockfish engine telemetry, depth tags (Sky 600)"
        },
        "dark": {
          "$value": "#38bdf8",
          "$type": "color",
          "$description": "Electric cyan telemetry accent (Sky 400)"
        }
      },
      "secondary-container": {
        "light": {
          "$value": "#e0f2fe",
          "$type": "color",
          "$description": "Engine status badges (Sky 100)"
        },
        "dark": {
          "$value": "#0284c7",
          "$type": "color",
          "$description": "Active analysis chips (Sky 600)"
        }
      },
      "on-secondary": {
        "light": { "$value": "#0369a1", "$type": "color" },
        "dark": { "$value": "#082f49", "$type": "color" }
      }
    },
    "surface": {
      "base": {
        "light": {
          "$value": "#f8f9ff",
          "$type": "color",
          "$description": "Global application background canvas"
        },
        "dark": {
          "$value": "#090d16",
          "$type": "color",
          "$description": "Obsidian dark base canvas"
        }
      },
      "dim": {
        "light": { "$value": "#cbdbf5", "$type": "color" },
        "dark": { "$value": "#060910", "$type": "color" }
      },
      "bright": {
        "light": { "$value": "#ffffff", "$type": "color" },
        "dark": { "$value": "#0f172a", "$type": "color" }
      },
      "container-lowest": {
        "light": { "$value": "#ffffff", "$type": "color" },
        "dark": { "$value": "#080c14", "$type": "color" }
      },
      "container-low": {
        "light": { "$value": "#eff4ff", "$type": "color" },
        "dark": { "$value": "#0f172a", "$type": "color" }
      },
      "container": {
        "light": { "$value": "#e5edfb", "$type": "color" },
        "dark": { "$value": "#131c2e", "$type": "color" }
      },
      "container-high": {
        "light": { "$value": "#dbe6f7", "$type": "color" },
        "dark": { "$value": "#1a263d", "$type": "color" }
      },
      "container-highest": {
        "light": { "$value": "#d0dff2", "$type": "color" },
        "dark": { "$value": "#22324f", "$type": "color" }
      }
    },
    "text": {
      "on-surface": {
        "light": { "$value": "#0f172a", "$type": "color" },
        "dark": { "$value": "#f1f5f9", "$type": "color" }
      },
      "on-surface-variant": {
        "light": { "$value": "#475569", "$type": "color" },
        "dark": { "$value": "#94a3b8", "$type": "color" }
      },
      "outline": {
        "light": { "$value": "#cbd5e1", "$type": "color" },
        "dark": { "$value": "#334155", "$type": "color" }
      },
      "outline-variant": {
        "light": { "$value": "#e2e8f0", "$type": "color" },
        "dark": { "$value": "#1e293b", "$type": "color" }
      }
    },
    "diagnostic": {
      "eval-advantage-white": {
        "$value": "#3b82f6",
        "$type": "color",
        "$description": "White positive centipawn evaluation bar fill"
      },
      "eval-advantage-black": {
        "$value": "#0f172a",
        "$type": "color",
        "$description": "Black territory balance on engine eval meter"
      },
      "brilliant": {
        "$value": "#06b6d4",
        "$type": "color",
        "$description": "Brilliant moves (!!) and speculative sacrifices"
      },
      "success": {
        "$value": "#10b981",
        "$type": "color",
        "$description": "Mastered lines, theoretical book moves"
      },
      "warning": {
        "$value": "#f59e0b",
        "$type": "color",
        "$description": "Inaccuracies (?!), spaced repetition reviews due"
      },
      "danger": {
        "$value": "#f43f5e",
        "$type": "color",
        "$description": "Blunders (??), tactical tripwires"
      }
    },
    "board": {
      "square-light": {
        "light": { "$value": "#f0d9b5", "$type": "color", "label": "Warm Cream" },
        "dark": { "$value": "#273549", "$type": "color", "label": "Muted Slate Ivory" }
      },
      "square-dark": {
        "light": { "$value": "#b58863", "$type": "color", "label": "Classic Walnut" },
        "dark": { "$value": "#162032", "$type": "color", "label": "Deep Obsidian Blue" }
      },
      "square-highlight": {
        "light": { "$value": "rgba(59, 130, 246, 0.45)", "$type": "color" },
        "dark": { "$value": "rgba(56, 189, 248, 0.45)", "$type": "color" }
      },
      "square-tripwire": {
        "light": { "$value": "rgba(244, 63, 94, 0.45)", "$type": "color" },
        "dark": { "$value": "rgba(244, 63, 94, 0.55)", "$type": "color" }
      }
    }
  },
  "typography": {
    "fontFamilies": {
      "display": {
        "$value": ["Newsreader", "Charter", "Georgia", "serif"],
        "$type": "fontFamily",
        "$description": "Editorial serif for hero headings, monographs, and GM commentary"
      },
      "sans": {
        "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"],
        "$type": "fontFamily",
        "$description": "Workhorse sans-serif for UI components, buttons, and metrics"
      },
      "mono": {
        "$value": ["JetBrains Mono", "Fira Code", "Consolas", "monospace"],
        "$type": "fontFamily",
        "$description": "Monospace for move notation ledger, FEN strings, and Stockfish engine telemetry"
      }
    },
    "scale": {
      "display-large": {
        "fontSize": { "$value": "48px", "$type": "dimension" },
        "lineHeight": { "$value": "1.1", "$type": "dimension" },
        "letterSpacing": { "$value": "-0.025em", "$type": "dimension" },
        "fontFamily": "{typography.fontFamilies.display}",
        "fontWeight": { "$value": 700, "$type": "fontWeight" }
      },
      "display-medium": {
        "fontSize": { "$value": "36px", "$type": "dimension" },
        "lineHeight": { "$value": "1.15", "$type": "dimension" },
        "letterSpacing": { "$value": "-0.02em", "$type": "dimension" },
        "fontFamily": "{typography.fontFamilies.display}",
        "fontWeight": { "$value": 700, "$type": "fontWeight" }
      },
      "display-small": {
        "fontSize": { "$value": "28px", "$type": "dimension" },
        "lineHeight": { "$value": "1.2", "$type": "dimension" },
        "letterSpacing": { "$value": "-0.015em", "$type": "dimension" },
        "fontFamily": "{typography.fontFamilies.display}",
        "fontWeight": { "$value": 600, "$type": "fontWeight" }
      },
      "title-large": {
        "fontSize": { "$value": "22px", "$type": "dimension" },
        "lineHeight": { "$value": "1.3", "$type": "dimension" },
        "letterSpacing": { "$value": "-0.01em", "$type": "dimension" },
        "fontFamily": "{typography.fontFamilies.display}",
        "fontWeight": { "$value": 600, "$type": "fontWeight" }
      },
      "title-medium": {
        "fontSize": { "$value": "18px", "$type": "dimension" },
        "lineHeight": { "$value": "1.35", "$type": "dimension" },
        "letterSpacing": { "$value": "-0.005em", "$type": "dimension" },
        "fontFamily": "{typography.fontFamilies.sans}",
        "fontWeight": { "$value": 600, "$type": "fontWeight" }
      },
      "title-small": {
        "fontSize": { "$value": "15px", "$type": "dimension" },
        "lineHeight": { "$value": "1.4", "$type": "dimension" },
        "letterSpacing": { "$value": "0em", "$type": "dimension" },
        "fontFamily": "{typography.fontFamilies.sans}",
        "fontWeight": { "$value": 600, "$type": "fontWeight" }
      },
      "body-large": {
        "fontSize": { "$value": "16px", "$type": "dimension" },
        "lineHeight": { "$value": "1.55", "$type": "dimension" },
        "letterSpacing": { "$value": "0em", "$type": "dimension" },
        "fontFamily": "{typography.fontFamilies.sans}",
        "fontWeight": { "$value": 400, "$type": "fontWeight" }
      },
      "body-medium": {
        "fontSize": { "$value": "14px", "$type": "dimension" },
        "lineHeight": { "$value": "1.5", "$type": "dimension" },
        "letterSpacing": { "$value": "0em", "$type": "dimension" },
        "fontFamily": "{typography.fontFamilies.sans}",
        "fontWeight": { "$value": 400, "$type": "fontWeight" }
      },
      "body-small": {
        "fontSize": { "$value": "12px", "$type": "dimension" },
        "lineHeight": { "$value": "1.4", "$type": "dimension" },
        "letterSpacing": { "$value": "0.01em", "$type": "dimension" },
        "fontFamily": "{typography.fontFamilies.sans}",
        "fontWeight": { "$value": 400, "$type": "fontWeight" }
      },
      "label-telemetry": {
        "fontSize": { "$value": "12px", "$type": "dimension" },
        "lineHeight": { "$value": "1.25", "$type": "dimension" },
        "letterSpacing": { "$value": "0.05em", "$type": "dimension" },
        "fontFamily": "{typography.fontFamilies.mono}",
        "fontWeight": { "$value": 500, "$type": "fontWeight" }
      },
      "caption-mono": {
        "fontSize": { "$value": "11px", "$type": "dimension" },
        "lineHeight": { "$value": "1.2", "$type": "dimension" },
        "letterSpacing": { "$value": "0.08em", "$type": "dimension" },
        "fontFamily": "{typography.fontFamilies.mono}",
        "fontWeight": { "$value": 600, "$type": "fontWeight" },
        "textTransform": "uppercase"
      }
    }
  },
  "spacing": {
    "space-1": { "$value": "4px", "$type": "dimension" },
    "space-2": { "$value": "8px", "$type": "dimension" },
    "space-3": { "$value": "12px", "$type": "dimension" },
    "space-4": { "$value": "16px", "$type": "dimension" },
    "space-6": { "$value": "24px", "$type": "dimension" },
    "space-8": { "$value": "32px", "$type": "dimension" },
    "space-12": { "$value": "48px", "$type": "dimension" },
    "space-16": { "$value": "64px", "$type": "dimension" }
  },
  "radii": {
    "radius-sm": { "$value": "4px", "$type": "dimension", "$description": "Badges, telemetry chips, table cells" },
    "radius-md": { "$value": "8px", "$type": "dimension", "$description": "Buttons, inputs, candidate move rows" },
    "radius-lg": { "$value": "12px", "$type": "dimension", "$description": "Chessboard wrapper, cards" },
    "radius-xl": { "$value": "16px", "$type": "dimension", "$description": "Analysis cockpit, dashboard containers" },
    "radius-full": { "$value": "9999px", "$type": "dimension", "$description": "Avatars, pills, toggle switches" }
  },
  "shadows": {
    "shadow-sm": { "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.05)", "$type": "shadow" },
    "shadow-md": { "$value": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)", "$type": "shadow" },
    "shadow-lg": { "$value": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)", "$type": "shadow" },
    "shadow-dark-elevated": { "$value": "0 8px 24px -4px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05)", "$type": "shadow" }
  }
}