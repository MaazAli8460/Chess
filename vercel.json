{
  "version": 2,
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python backend/manage.py collectstatic --noinput",
  "functions": {
    "api/index.py": {
      "runtime": "python3.11",
      "includeFiles": [
        "backend/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
