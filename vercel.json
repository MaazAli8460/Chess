{
  "version": 2,
  "outputDirectory": "output",
  "installCommand": "uv pip install --system -r backend/requirements.txt",
  "buildCommand": "python backend/manage.py collectstatic --noinput",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
