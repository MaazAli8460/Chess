{
  "version": 2,
  "installCommand": "uv venv && uv pip install -r requirements.txt",
  "buildCommand": "uv run python backend/manage.py collectstatic --noinput",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
